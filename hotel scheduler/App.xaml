<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:converters="clr-namespace:hotel_scheduler.Converters"
             x:Class="hotel_scheduler.App"
             UserAppTheme="Light">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <toolkit:InvertedBoolConverter x:Key="InverseBoolConverter"/>

                    <!-- Global Light Theme Fallbacks -->
                    <Style TargetType="Entry">
                        <Setter Property="TextColor" Value="#1A1A1A"/>
                        <Setter Property="PlaceholderColor" Value="#AAAAAA"/>
                        <Setter Property="BackgroundColor" Value="Transparent"/>
                    </Style>

                    <Style TargetType="Editor">
                        <Setter Property="TextColor" Value="#1A1A1A"/>
                        <Setter Property="PlaceholderColor" Value="#AAAAAA"/>
                        <Setter Property="BackgroundColor" Value="Transparent"/>
                    </Style>

                    <Style TargetType="Picker">
                        <Setter Property="TextColor" Value="#1A1A1A"/>
                        <Setter Property="TitleColor" Value="#AAAAAA"/>
                        <Setter Property="BackgroundColor" Value="Transparent"/>
                    </Style>

                    <Style TargetType="DatePicker">
                        <Setter Property="TextColor" Value="#1A1A1A"/>
                        <Setter Property="BackgroundColor" Value="Transparent"/>
                    </Style>

                    <Style TargetType="Label">
                        <Setter Property="TextColor" Value="#1A1A1A"/>
                    </Style>

                    <Style TargetType="Button">
                        <Setter Property="TextColor" Value="#1A1A1A"/>
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>