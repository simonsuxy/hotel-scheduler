<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:dal="clr-namespace:DAL.Entities;assembly=DAL"
             xmlns:vm="clr-namespace:hotel_scheduler.ViewModels"
             x:Class="hotel_scheduler.Views.RoomsView"
             BackgroundColor="#F5F5F5">

    <Grid ColumnDefinitions="350,*" ColumnSpacing="16" Padding="16">

        <!-- LEFT PANEL: Add Room Form & Create New RoomType -->
        <Border Grid.Column="0" BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="16">
            <ScrollView VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="12">

                    <Label Text="Add New Room" FontSize="16" FontAttributes="Bold" TextColor="#1A1A1A"/>

                    <!-- Room Name -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Room Name / Number" FontSize="12" TextColor="#888888"/>
                        <Entry Placeholder="e.g. 101 or Suite A" Text="{Binding NewRoomName}" HeightRequest="40" FontSize="13"/>
                    </VerticalStackLayout>

                    <!-- Room Type Picker -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Room Type" FontSize="12" TextColor="#888888"/>
                        <Picker ItemsSource="{Binding RoomTypes}" SelectedItem="{Binding NewRoomType}" HeightRequest="40" FontSize="13"/>
                    </VerticalStackLayout>

                    <!-- Inline Create New RoomType Field -->
                    <Border Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10" BackgroundColor="#F8F9FA">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Create Custom Room Type" FontSize="11" FontAttributes="Bold" TextColor="#888888"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <Entry Grid.Column="0" Placeholder="e.g. Deluxe Suite" Text="{Binding CustomRoomTypeName}" HeightRequest="36" FontSize="12"/>
                                <Button Grid.Column="1" Text="+ Add Type" Command="{Binding AddRoomTypeCommand}"
                                        BackgroundColor="#4C4EE7" TextColor="White" CornerRadius="6" HeightRequest="36" Padding="10,0" FontSize="11"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Price & Capacity -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Price / Night" FontSize="12" TextColor="#888888"/>
                            <Entry Placeholder="0.00" Text="{Binding NewRoomPrice}" Keyboard="Numeric" HeightRequest="40" FontSize="13"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Capacity" FontSize="12" TextColor="#888888"/>
                            <Entry Text="{Binding NewRoomCapacity}" Keyboard="Numeric" HeightRequest="40" FontSize="13"/>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Room Status -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Status" FontSize="12" TextColor="#888888"/>
                        <Picker ItemsSource="{Binding RoomStatuses}" SelectedItem="{Binding NewRoomStatus}" HeightRequest="40" FontSize="13"/>
                    </VerticalStackLayout>

                    <!-- Notes -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Notes" FontSize="12" TextColor="#888888"/>
                        <Editor Placeholder="Optional notes..." Text="{Binding NewRoomNotes}" HeightRequest="60" FontSize="13"/>
                    </VerticalStackLayout>

                    <!-- Error Display -->
                    <Label Text="{Binding ErrorMessage}" TextColor="#E53935" FontSize="12" IsVisible="{Binding HasError}" HorizontalOptions="Center"/>

                    <!-- Add Room Button -->
                    <Button Text="+ Create Room" Command="{Binding CreateRoomCommand}"
                            BackgroundColor="#4C4EE7" TextColor="White" CornerRadius="20" HeightRequest="40" FontSize="13" Margin="0,4,0,0"/>
                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <!-- RIGHT PANEL: Room List (Modified On-Page) -->
        <Border Grid.Column="1" BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="16">
            <Grid RowDefinitions="Auto,*">
                <Label Grid.Row="0" Text="Rooms Directory" FontSize="16" FontAttributes="Bold" TextColor="#1A1A1A" Margin="0,0,0,12"/>

                <CollectionView Grid.Row="1" ItemsSource="{Binding Rooms}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="No rooms created yet" FontSize="13" TextColor="#AAAAAA" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:RoomItemViewModel">
                            <Border Stroke="#F0F0F0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="14" Margin="0,0,0,10" BackgroundColor="White">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">

                                    <!-- ================= VIEW MODE ================= -->
                                    <VerticalStackLayout Grid.Column="0" Spacing="6"
                                                         IsVisible="{Binding IsEditing, Converter={StaticResource InverseBoolConverter}}">
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" TextColor="#1A1A1A"/>
                                            <Label Text="{Binding Type}" FontSize="12" TextColor="#4C4EE7" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>

                                        <HorizontalStackLayout Spacing="16">
                                            <Label Text="{Binding Capacity, StringFormat='Capacity: {0} guests'}" FontSize="12" TextColor="#666666"/>
                                            <Label Text="{Binding PricePerNight, StringFormat='{0:C} / night'}" FontSize="12" FontAttributes="Bold" TextColor="#1A1A1A"/>
                                            <Label Text="{Binding Status}" FontSize="12" TextColor="#888888"/>
                                        </HorizontalStackLayout>

                                        <Label Text="{Binding Notes}" FontSize="12" TextColor="#888888"/>
                                    </VerticalStackLayout>


                                    <!-- ================= EDIT MODE (SPACIOUS MULTI-ROW GRID) ================= -->
                                    <Grid Grid.Column="0" 
                                          RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*,*" 
                                          RowSpacing="10" ColumnSpacing="12"
                                          IsVisible="{Binding IsEditing}">

                                        <!-- Row 0: Name, Type, Status -->
                                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                            <Label Text="Name" FontSize="11" FontAttributes="Bold" TextColor="#888888"/>
                                            <Entry Text="{Binding EditName}" Placeholder="Name" FontSize="13" HeightRequest="38"/>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                                            <Label Text="Type" FontSize="11" FontAttributes="Bold" TextColor="#888888"/>
                                            <Picker ItemsSource="{Binding BindingContext.RoomTypes, Source={RelativeSource AncestorType={x:Type ContentView}}}" 
                                                    SelectedItem="{Binding EditType}" FontSize="12" HeightRequest="38"/>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Row="0" Grid.Column="2" Spacing="2">
                                            <Label Text="Status" FontSize="11" FontAttributes="Bold" TextColor="#888888"/>
                                            <Picker ItemsSource="{Binding BindingContext.RoomStatuses, Source={RelativeSource AncestorType={x:Type ContentView}}}" 
                                                    SelectedItem="{Binding EditStatus}" FontSize="12" HeightRequest="38"/>
                                        </VerticalStackLayout>

                                        <!-- Row 1: Price / Night, Capacity -->
                                        <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="2">
                                            <Label Text="Price / Night" FontSize="11" FontAttributes="Bold" TextColor="#888888"/>
                                            <Entry Text="{Binding EditPriceText}" Keyboard="Numeric" Placeholder="0.00" FontSize="13" HeightRequest="38"/>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                                            <Label Text="Capacity" FontSize="11" FontAttributes="Bold" TextColor="#888888"/>
                                            <Entry Text="{Binding EditCapacity}" Keyboard="Numeric" Placeholder="1" FontSize="13" HeightRequest="38"/>
                                        </VerticalStackLayout>

                                        <!-- Row 2: Notes (Full Width across all 3 columns) -->
                                        <VerticalStackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Spacing="2">
                                            <Label Text="Notes" FontSize="11" FontAttributes="Bold" TextColor="#888888"/>
                                            <Entry Text="{Binding EditNotes}" Placeholder="Optional notes..." FontSize="13" HeightRequest="38"/>
                                        </VerticalStackLayout>
                                    </Grid>


                                    <!-- ================= ACTION BUTTONS ================= -->
                                    <HorizontalStackLayout Grid.Column="1" Spacing="4" 
                                                           IsVisible="{Binding IsEditing, Converter={StaticResource InverseBoolConverter}}" 
                                                           VerticalOptions="Start">
                                        <!-- Edit Button -->
                                        <Button Text="✎"
                                                Command="{Binding BindingContext.ToggleEditRoomCommand, Source={RelativeSource AncestorType={x:Type ContentView}}}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="Transparent" TextColor="#888888" WidthRequest="32" HeightRequest="32" Padding="0"/>

                                        <!-- Delete Button (Visible only when room has no reservations) -->
                                        <Button Text="🗑"
                                                IsVisible="{Binding CanDelete}"
                                                Command="{Binding BindingContext.DeleteRoomCommand, Source={RelativeSource AncestorType={x:Type ContentView}}}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="Transparent" TextColor="#E53935" WidthRequest="32" HeightRequest="32" Padding="0"/>
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Grid.Column="1" Spacing="4" IsVisible="{Binding IsEditing}" VerticalOptions="Start">
                                        <Button Text="✓"
                                                Command="{Binding BindingContext.SaveEditedRoomCommand, Source={RelativeSource AncestorType={x:Type ContentView}}}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="Transparent" TextColor="#43A047" FontAttributes="Bold" WidthRequest="32" HeightRequest="32" Padding="0"/>

                                        <Button Text="✕"
                                                Command="{Binding BindingContext.ToggleEditRoomCommand, Source={RelativeSource AncestorType={x:Type ContentView}}}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="Transparent" TextColor="#E53935" WidthRequest="32" HeightRequest="32" Padding="0"/>
                                    </HorizontalStackLayout>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>
    </Grid>
</ContentView>