<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="hotel_scheduler.Views.SettingsView"
             BackgroundColor="#F5F5F5">

    <ScrollView HorizontalOptions="Fill">
        <VerticalStackLayout Padding="24" Spacing="24" HorizontalOptions="Fill">

            <!-- Page Header -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Settings" FontSize="24" FontAttributes="Bold" TextColor="#1A1A1A"/>
                <Label Text="Manage your hotel details, operating hours, and database." FontSize="13" TextColor="#888888"/>
            </VerticalStackLayout>

            <!-- General Details Card -->
            <Border BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="20" HorizontalOptions="Fill">
                <VerticalStackLayout Spacing="16">
                    <Label Text="General Details" FontSize="16" FontAttributes="Bold" TextColor="#1A1A1A"/>

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16" HorizontalOptions="Fill">
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                            <Label Text="Hotel Name" FontSize="12" TextColor="#888888"/>
                            <Entry Text="{Binding HotelName}" FontSize="14" HeightRequest="40" BackgroundColor="#F8F9FA" TextColor="#1A1A1A"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                            <Label Text="Email" FontSize="12" TextColor="#888888"/>
                            <Entry Text="{Binding Email}" FontSize="14" HeightRequest="40" BackgroundColor="#F8F9FA" Keyboard="Email" TextColor="#1A1A1A"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4">
                            <Label Text="Address" FontSize="12" TextColor="#888888"/>
                            <Entry Text="{Binding Address}" FontSize="14" HeightRequest="40" BackgroundColor="#F8F9FA" TextColor="#1A1A1A"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4">
                            <Label Text="Phone Number" FontSize="12" TextColor="#888888"/>
                            <Entry Text="{Binding Phone}" FontSize="14" HeightRequest="40" BackgroundColor="#F8F9FA" Keyboard="Telephone" TextColor="#1A1A1A"/>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Operations & Preferences Card -->
            <Border BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="20" HorizontalOptions="Fill">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Operations &amp; Preferences" FontSize="16" FontAttributes="Bold" TextColor="#1A1A1A"/>

                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16" HorizontalOptions="Fill">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Default Check-In Time" FontSize="12" TextColor="#888888"/>
                            <TimePicker Time="{Binding DefaultCheckInTime}" Format="h:mm tt" FontSize="14" HeightRequest="40" BackgroundColor="#F8F9FA" TextColor="#1A1A1A"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Default Check-Out Time" FontSize="12" TextColor="#888888"/>
                            <TimePicker Time="{Binding DefaultCheckOutTime}" Format="h:mm tt" FontSize="14" HeightRequest="40" BackgroundColor="#F8F9FA" TextColor="#1A1A1A"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" Spacing="4">
                            <Label Text="Currency" FontSize="12" TextColor="#888888"/>
                            <Entry Text="{Binding Currency}" FontSize="14" HeightRequest="40" BackgroundColor="#F8F9FA" TextColor="#1A1A1A"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="3" Spacing="4">
                            <Label Text="Default Calendar Days" FontSize="12" TextColor="#888888"/>
                            <Entry Text="{Binding DefaultCalendarDays}" Keyboard="Numeric" FontSize="14" HeightRequest="40" BackgroundColor="#F8F9FA" TextColor="#1A1A1A"/>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Database & Data Management Card -->
            <Border BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="20" HorizontalOptions="Fill">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Database &amp; Data Management" FontSize="16" FontAttributes="Bold" TextColor="#1A1A1A"/>

                    <Grid ColumnDefinitions="*,Auto" RowSpacing="12" RowDefinitions="Auto,Auto,Auto" HorizontalOptions="Fill">

                        <!-- CSV Export -->
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="Export Reservations" FontSize="14" FontAttributes="Bold" TextColor="#1A1A1A"/>
                            <Label Text="Download a CSV spreadsheet of your reservations by date range." FontSize="12" TextColor="#888888"/>
                        </VerticalStackLayout>
                        <Button Grid.Row="0" Grid.Column="1" Text="Select Dates &amp; Export CSV" Command="{Binding ExportCsvCommand}"
                                BackgroundColor="White" TextColor="#4C4EE7" BorderColor="#4C4EE7" BorderWidth="1" CornerRadius="8" Padding="16,6" HeightRequest="36"/>

                        <!-- Backup DB -->
                        <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="Backup Database" FontSize="14" FontAttributes="Bold" TextColor="#1A1A1A"/>
                            <Label Text="Save a physical copy of your raw data.sqlite file." FontSize="12" TextColor="#888888"/>
                        </VerticalStackLayout>
                        <Button Grid.Row="1" Grid.Column="1" Text="Backup to File" Command="{Binding BackupDatabaseCommand}"
                                BackgroundColor="White" TextColor="#1A1A1A" BorderColor="#E0E0E0" BorderWidth="1" CornerRadius="8" Padding="16,6" HeightRequest="36"/>

                        <!-- Restore DB -->
                        <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="Restore Database" FontSize="14" FontAttributes="Bold" TextColor="#1A1A1A"/>
                            <Label Text="Overwrite current system data with a previous backup file." FontSize="12" TextColor="#888888"/>
                        </VerticalStackLayout>
                        <Button Grid.Row="2" Grid.Column="1" Text="Restore from File" Command="{Binding RestoreDatabaseCommand}"
                                BackgroundColor="White" TextColor="#E53935" BorderColor="#E53935" BorderWidth="1" CornerRadius="8" Padding="16,6" HeightRequest="36"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Action Footer -->
            <Grid ColumnDefinitions="*,Auto" HorizontalOptions="Fill">
                <Label Grid.Column="0" Text="{Binding StatusMessage}" TextColor="{Binding StatusColor}" FontAttributes="Bold" VerticalOptions="Center" IsVisible="{Binding ShowStatus}"/>

                <Button Grid.Column="1" Text="Save Settings" Command="{Binding SaveSettingsCommand}"
                        BackgroundColor="#4C4EE7" TextColor="White" CornerRadius="8" Padding="32,8" HeightRequest="44"/>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>