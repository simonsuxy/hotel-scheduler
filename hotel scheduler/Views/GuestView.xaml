<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:hotel_scheduler.Models.Entities"
             x:Class="hotel_scheduler.Views.GuestsView">

    <Grid RowDefinitions="Auto,Auto,Auto,*"
          BackgroundColor="#F5F5F5">

        <!-- Top bar — search + new guest button -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Padding="16,12"
              BackgroundColor="White">

            <Entry Placeholder="Search by name..."
                   Text="{Binding SearchQuery}"
                   FontSize="13"
                   VerticalOptions="Center"
                   HorizontalOptions="Fill"/>

            <Button Grid.Column="1"
                    Text="+ New guest"
                    BackgroundColor="White"
                    TextColor="#4C4EE7"
                    BorderColor="#4C4EE7"
                    BorderWidth="1"
                    CornerRadius="20"
                    FontSize="13"
                    Padding="14,0"
                    HeightRequest="40"
                    Command="{Binding OpenNewGuestCommand}"/>
        </Grid>

        <!-- Filter toggles -->
        <HorizontalStackLayout Grid.Row="1"
                       Padding="16,8"
                       Spacing="8"
                       BackgroundColor="White">
            <!-- Current -->
            <Border Padding="10,6"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="1.5"
                    Stroke="{Binding ShowCurrent, Converter={StaticResource BoolToAccentColorConverter}}"
                    BackgroundColor="{Binding ShowCurrent, Converter={StaticResource BoolToAccentBgConverter}}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleCurrentCommand}"/>
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="6">
                    <BoxView WidthRequest="8" HeightRequest="8"
                             CornerRadius="4"
                             BackgroundColor="#43A047"
                             VerticalOptions="Center"/>
                    <Label Text="Current" FontSize="12"
                           TextColor="{Binding ShowCurrent, Converter={StaticResource BoolToAccentColorConverter}}"
                           VerticalOptions="Center"/>
                    <!-- Checkmark when active -->
                    <Label Text="✓"
                           FontSize="11"
                           TextColor="#4C4EE7"
                           VerticalOptions="Center"
                           IsVisible="{Binding ShowCurrent}"/>
                </HorizontalStackLayout>
            </Border>

            <!-- Future -->
            <Border Padding="10,6"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="1.5"
                    Stroke="{Binding ShowFuture, Converter={StaticResource BoolToAccentColorConverter}}"
                    BackgroundColor="{Binding ShowFuture, Converter={StaticResource BoolToAccentBgConverter}}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleFutureCommand}"/>
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="6">
                    <BoxView WidthRequest="8" HeightRequest="8"
                     CornerRadius="4"
                     BackgroundColor="#4C4EE7"
                     VerticalOptions="Center"/>
                    <Label Text="Future" FontSize="12"
                           TextColor="{Binding ShowFuture, Converter={StaticResource BoolToAccentColorConverter}}"
                           VerticalOptions="Center"/>
                    <Label Text="✓"
                           FontSize="11"
                           TextColor="#4C4EE7"
                           VerticalOptions="Center"
                           IsVisible="{Binding ShowFuture}"/>
                </HorizontalStackLayout>
            </Border>

            <!-- Past -->
            <Border Padding="10,6"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="1.5"
                    Stroke="{Binding ShowPast, Converter={StaticResource BoolToAccentColorConverter}}"
                    BackgroundColor="{Binding ShowPast, Converter={StaticResource BoolToAccentBgConverter}}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding TogglePastCommand}"/>
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="6">
                    <BoxView WidthRequest="8" HeightRequest="8"
                             CornerRadius="4"
                             BackgroundColor="#FB8C00"
                             VerticalOptions="Center"/>
                    <Label Text="Past" FontSize="12"
                           TextColor="{Binding ShowPast, Converter={StaticResource BoolToAccentColorConverter}}"
                           VerticalOptions="Center"/>
                    <Label Text="✓"
                           FontSize="11"
                           TextColor="#4C4EE7"
                           VerticalOptions="Center"
                           IsVisible="{Binding ShowPast}"/>
                </HorizontalStackLayout>
            </Border>
        </HorizontalStackLayout>

        <!-- No filters warning -->
        <Border Grid.Row="2"
                IsVisible="{Binding NoFiltersSelected}"
                BackgroundColor="#FFF8E1"
                Stroke="#FFE082"
                StrokeThickness="1"
                Margin="16,8"
                Padding="12,8"
                StrokeShape="RoundRectangle 8">
            <Label Text="No filters selected — select at least one to see guests"
                   FontSize="12"
                   TextColor="#F57F17"
                   HorizontalTextAlignment="Center"/>
        </Border>

        <!-- Guest list -->
        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding FilteredGuests}"
                        SelectionMode="None"
                        Margin="16,8">
            <CollectionView.EmptyView>
                <Label Text="No guests found"
                       FontSize="14"
                       TextColor="#AAAAAA"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Margin="0,40"/>
            </CollectionView.EmptyView>
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:GuestDTO">
                    <Border BackgroundColor="White"
                            Stroke="#E0E0E0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="16,12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding BindingContext.OpenEditGuestCommand,
                                    Source={RelativeSource AncestorType={x:Type ContentView}}}"
                                CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="Auto,*,Auto"
                              RowDefinitions="Auto,Auto">

                            <!-- Status dot -->
                            <BoxView Grid.Row="0" Grid.Column="0"
                                     WidthRequest="10"
                                     HeightRequest="10"
                                     CornerRadius="5"
                                     BackgroundColor="{Binding StatusColor}"
                                     VerticalOptions="Center"
                                     Margin="0,0,10,0"/>

                            <!-- Guest name -->
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding FullName}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#1A1A1A"
                                   VerticalOptions="Center"/>

                            <!-- Status label -->
                            <Label Grid.Row="0" Grid.Column="2"
                                   Text="{Binding StatusLabel}"
                                   FontSize="11"
                                   TextColor="{Binding StatusDotColor}"
                                   VerticalOptions="Center"/>

                            <!-- Reservations list — dates + room, stacked -->
                            <VerticalStackLayout Grid.Row="1"
                                                 Grid.Column="1"
                                                 Grid.ColumnSpan="2"
                                                 Spacing="2"
                                                 Margin="0,6,0,0">
                                <BindableLayout.ItemsSource>
                                    <Binding Path="Reservations"/>
                                </BindableLayout.ItemsSource>
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="local:ReservationDTO">
                                        <HorizontalStackLayout Spacing="8">
                                            <!-- Room name -->
                                            <Label Text="{Binding RoomName}"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextColor="#555555"/>
                                            <!-- Dates -->
                                            <Label FontSize="11"
                                                   TextColor="#888888">
                                                <Label.Text>
                                                    <MultiBinding StringFormat="{}{0:MMM d} → {1:MMM d yyyy}">
                                                        <Binding Path="CheckIn"/>
                                                        <Binding Path="CheckOut"/>
                                                    </MultiBinding>
                                                </Label.Text>
                                            </Label>
                                        </HorizontalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentView>