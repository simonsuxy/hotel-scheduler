<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:local="clr-namespace:hotel_scheduler.Models.Entities"
    x:Class="hotel_scheduler.Views.GuestPopup"
    CanBeDismissedByTappingOutsideOfPopup="True"
    HorizontalOptions="End"
    VerticalOptions="Fill">

    <Border WidthRequest="380"
            BackgroundColor="White"
            StrokeThickness="0"
            VerticalOptions="Fill">
        <ScrollView>
            <VerticalStackLayout Padding="24" Spacing="16">

                <!-- Header — title changes based on mode -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#1A1A1A"
                           VerticalOptions="Center">
                        <Label.Text>
                            <Binding Path="IsEditing">
                                <Binding.Converter>
                                    <toolkit:BoolToObjectConverter
                                        TrueObject="Edit guest"
                                        FalseObject="New guest"/>
                                </Binding.Converter>
                            </Binding>
                        </Label.Text>
                    </Label>
                    <Button Grid.Column="1"
                            Text="X"
                            BackgroundColor="Transparent"
                            TextColor="#888888"
                            FontSize="16"
                            WidthRequest="36"
                            HeightRequest="36"
                            Padding="0"
                            Clicked="OnCloseClicked"/>
                </Grid>

                <BoxView HeightRequest="1" BackgroundColor="#F0F0F0"/>

                <!-- First + Last name side by side -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                        <Label Text="First name" FontSize="12" TextColor="#888888"/>
                        <Entry Placeholder="First name"
                               Text="{Binding FirstName}"
                               HeightRequest="44"
                               FontSize="13"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label Text="Last name" FontSize="12" TextColor="#888888"/>
                        <Entry Placeholder="Last name"
                               Text="{Binding LastName}"
                               HeightRequest="44"
                               FontSize="13"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- Optional section -->
                <Label Text="Optional"
                       FontSize="12"
                       TextColor="#AAAAAA"
                       Margin="0,4,0,0"/>
                <BoxView HeightRequest="1" BackgroundColor="#F0F0F0"/>

                <!-- Phone + Email -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                        <Label Text="Phone" FontSize="12" TextColor="#888888"/>
                        <Entry Placeholder="Phone"
                               Text="{Binding Phone}"
                               Keyboard="Telephone"
                               HeightRequest="44"
                               FontSize="13"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label Text="Email" FontSize="12" TextColor="#888888"/>
                        <Entry Placeholder="Email"
                               Text="{Binding Email}"
                               Keyboard="Email"
                               HeightRequest="44"
                               FontSize="13"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- ID + Address -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                        <Label Text="ID number" FontSize="12" TextColor="#888888"/>
                        <Entry Placeholder="ID / Passport"
                               Text="{Binding IdNumber}"
                               HeightRequest="44"
                               FontSize="13"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label Text="Address" FontSize="12" TextColor="#888888"/>
                        <Entry Placeholder="Address"
                               Text="{Binding Address}"
                               HeightRequest="44"
                               FontSize="13"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- Notes -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Notes" FontSize="12" TextColor="#888888"/>
                    <Editor Placeholder="Notes..."
                            Text="{Binding Notes}"
                            HeightRequest="70"
                            FontSize="13"/>
                </VerticalStackLayout>

                <!-- Reservations — edit mode only -->
                <VerticalStackLayout IsVisible="{Binding IsEditing}" Spacing="8">
                    <BoxView HeightRequest="1" BackgroundColor="#F0F0F0"/>
                    <Label Text="Reservations"
                           FontSize="12"
                           TextColor="#888888"/>
                    <CollectionView ItemsSource="{Binding Reservations}"
                                    HeightRequest="120"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Text="No reservations"
                                   FontSize="12"
                                   TextColor="#AAAAAA"
                                   HorizontalOptions="Center"
                                   Margin="0,12"/>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="local:ReservationDTO">
                                <Grid ColumnDefinitions="*,*,Auto"
                                      Padding="0,6">
                                    <Label Grid.Column="0"
                                           Text="{Binding CheckIn, StringFormat='{0:MMM d yyyy}'}"
                                           FontSize="12"
                                           TextColor="#1A1A1A"/>
                                    <Label Grid.Column="1"
                                           Text="{Binding CheckOut, StringFormat='→ {0:MMM d}'}"
                                           FontSize="12"
                                           TextColor="#888888"/>
                                    <Label Grid.Column="2"
                                           Text="{Binding PaymentStatus}"
                                           FontSize="11"
                                           TextColor="#888888"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Error -->
                <Label Text="{Binding ErrorMessage}"
                       TextColor="#E53935"
                       FontSize="12"
                       IsVisible="{Binding HasError}"/>

                <!-- Save + Cancel -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Grid.Column="0"
                            Text="Save"
                            BackgroundColor="White"
                            TextColor="#1A1A1A"
                            BorderColor="#E0E0E0"
                            BorderWidth="1"
                            CornerRadius="20"
                            HeightRequest="44"
                            Command="{Binding SaveCommand}"/>
                    <Button Grid.Column="1"
                            Text="Cancel"
                            BackgroundColor="White"
                            TextColor="#E53935"
                            BorderColor="#E53935"
                            BorderWidth="1"
                            CornerRadius="20"
                            HeightRequest="44"
                            Clicked="OnCloseClicked"/>
                </Grid>

                <!-- Delete — edit mode only -->
                <Button Text="Delete guest"
                        BackgroundColor="Transparent"
                        TextColor="#E53935"
                        FontSize="12"
                        IsVisible="{Binding IsEditing}"
                        Command="{Binding DeleteCommand}"/>

            </VerticalStackLayout>
        </ScrollView>
    </Border>
</toolkit:Popup>