<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:local="clr-namespace:hotel_scheduler.Models.Entities"
             xmlns:vm="clr-namespace:hotel_scheduler.ViewModels"
             x:Class="hotel_scheduler.Views.FinanceView"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="16">

        <!-- Top Overview Cards -->
        <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*" ColumnSpacing="12">

            <!-- Total Revenue -->
            <Border Grid.Column="0" BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="16">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Total Revenue" FontSize="12" TextColor="#888888"/>
                    <Label Text="{Binding TotalRevenue, StringFormat='{0:C}'}" FontSize="20" FontAttributes="Bold" TextColor="#1A1A1A"/>
                </VerticalStackLayout>
            </Border>

            <!-- Paid / Collected -->
            <Border Grid.Column="1" BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="16">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Paid / Collected" FontSize="12" TextColor="#888888"/>
                    <Label Text="{Binding CollectedIncome, StringFormat='{0:C}'}" FontSize="20" FontAttributes="Bold" TextColor="#43A047"/>
                </VerticalStackLayout>
            </Border>

            <!-- Unpaid / Pending -->
            <Border Grid.Column="2" BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="16">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Pending Balance" FontSize="12" TextColor="#888888"/>
                    <Label Text="{Binding PendingBalance, StringFormat='{0:C}'}" FontSize="20" FontAttributes="Bold" TextColor="#E53935"/>
                </VerticalStackLayout>
            </Border>

            <!-- Total Line Items / Extras -->
            <Border Grid.Column="3" BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="16">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Extras Revenue" FontSize="12" TextColor="#888888"/>
                    <Label Text="{Binding TotalExtrasRevenue, StringFormat='{0:C}'}" FontSize="20" FontAttributes="Bold" TextColor="#4C4EE7"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Main Content Area: Left (Categories) vs Right (Financial Log) -->
        <Grid Grid.Row="1" ColumnDefinitions="340,*" ColumnSpacing="16">

            <!-- Category Management Section -->
            <Border Grid.Column="0" BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Manage Charge Categories" FontSize="16" FontAttributes="Bold" TextColor="#1A1A1A"/>

                    <!-- Category Name -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Category Name" FontSize="12" TextColor="#888888"/>
                        <Entry Placeholder="e.g. Extra Bed Sheets" Text="{Binding NewCategoryName}" HeightRequest="40" FontSize="13"/>
                    </VerticalStackLayout>

                    <!-- Description -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Description (Optional)" FontSize="12" TextColor="#888888"/>
                        <Entry Placeholder="e.g. One-time fee for extra linens" Text="{Binding NewCategoryDescription}" HeightRequest="40" FontSize="13"/>
                    </VerticalStackLayout>

                    <!-- Price + Type -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Price" FontSize="12" TextColor="#888888"/>
                            <Entry Placeholder="0.00" Text="{Binding NewCategoryPrice}" Keyboard="Numeric" HeightRequest="40" FontSize="13"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Type" FontSize="12" TextColor="#888888"/>
                            <Picker ItemsSource="{Binding ChargeTypes}" SelectedItem="{Binding NewCategoryType}" HeightRequest="40" FontSize="13"/>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Error message display -->
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="#E53935"
                           FontSize="12"
                           IsVisible="{Binding HasError}"
                           HorizontalOptions="Center" />

                    <!-- Add Category Button -->
                    <Button Text="+ Create Category"
                            Command="{Binding AddCategoryCommand}"
                            BackgroundColor="#4C4EE7"
                            TextColor="White"
                            CornerRadius="20"
                            HeightRequest="38"
                            FontSize="13"/>

                    <BoxView HeightRequest="1" BackgroundColor="#F0F0F0" Margin="0,4"/>

                    <!-- Category List -->
                    <Label Text="Active Categories" FontSize="13" FontAttributes="Bold" TextColor="#888888"/>

                    <CollectionView ItemsSource="{Binding Categories}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChargeCategoryItemViewModel">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" Padding="0,8" ColumnSpacing="8">

                                    <!-- ================= VIEW MODE ================= -->
                                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2" 
                                                         IsVisible="{Binding IsEditing, Converter={StaticResource InverseBoolConverter}}">
                                        <Label Text="{Binding EditName}" FontSize="13" FontAttributes="Bold" TextColor="#1A1A1A"/>
                                        <Label Text="{Binding EditDescription}" FontSize="11" TextColor="#666666" MaxLines="2" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding EditType}" FontSize="11" TextColor="#888888"/>
                                    </VerticalStackLayout>

                                    <Label Grid.Column="1" Text="{Binding EditPrice, StringFormat='{0:C}'}" FontSize="13" FontAttributes="Bold" 
                                           VerticalOptions="Center" TextColor="#4C4EE7" 
                                           IsVisible="{Binding IsEditing, Converter={StaticResource InverseBoolConverter}}"/>


                                    <!-- ================= EDIT MODE ================= -->
                                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="4" 
                                                         IsVisible="{Binding IsEditing}">
                                        <Entry Text="{Binding EditName}" FontSize="13" HeightRequest="36" BackgroundColor="#F5F5F5" Margin="0,0,8,0" />
                                        <Entry Text="{Binding EditDescription}" FontSize="11" HeightRequest="36" Placeholder="Description..." BackgroundColor="#F5F5F5" Margin="0,0,8,0"/>
                                        <Picker ItemsSource="{Binding BindingContext.ChargeTypes, Source={RelativeSource AncestorType={x:Type ContentView}}}" 
                                                SelectedItem="{Binding EditType}" FontSize="11" HeightRequest="36" BackgroundColor="#F5F5F5" Margin="0,0,8,0"/>
                                    </VerticalStackLayout>

                                    <Entry Grid.Column="1" Text="{Binding EditPrice}" Keyboard="Numeric" FontSize="13" VerticalOptions="Center" TextColor="#4C4EE7" 
                                           IsVisible="{Binding IsEditing}" HeightRequest="36" WidthRequest="60" BackgroundColor="#F5F5F5"/>


                                    <!-- ================= ACTION BUTTONS ================= -->

                                    <!-- Edit Button (Shows in View Mode) -->
                                    <Button Grid.Column="2" Text="✎" 
                                            IsVisible="{Binding IsEditing, Converter={StaticResource InverseBoolConverter}}"
                                            Command="{Binding BindingContext.ToggleEditCategoryCommand, Source={RelativeSource AncestorType={x:Type ContentView}}}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="Transparent" TextColor="#888888" Padding="0" WidthRequest="28" HeightRequest="28"/>

                                    <!-- Save Button (Shows in Edit Mode) -->
                                    <Button Grid.Column="2" Text="✓" 
                                            IsVisible="{Binding IsEditing}"
                                            Command="{Binding BindingContext.SaveEditedCategoryCommand, Source={RelativeSource AncestorType={x:Type ContentView}}}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="Transparent" TextColor="#43A047" FontAttributes="Bold" Padding="0" WidthRequest="28" HeightRequest="28"/>

                                    <!-- Delete Button (Always hidden for pre-created items) -->
                                    <Button Grid.Column="3" Text="✕" 
                                            IsVisible="{Binding IsPreCreated, Converter={StaticResource InverseBoolConverter}}"
                                            Command="{Binding BindingContext.DeleteCategoryCommand, Source={RelativeSource AncestorType={x:Type ContentView}}}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="Transparent" TextColor="#E53935" Padding="0" WidthRequest="28" HeightRequest="28"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Revenue Log / Financial Breakdown -->
            <Border Grid.Column="1" BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Reservation Financial History" FontSize="16" FontAttributes="Bold" TextColor="#1A1A1A"/>

                    <CollectionView ItemsSource="{Binding Reservations}" SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Text="No financial entries recorded" FontSize="13" TextColor="#AAAAAA" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,40"/>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="local:ReservationDTO">
                                <Border Stroke="#F0F0F0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">

                                        <!-- Guest & Room details -->
                                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding GuestName}" FontSize="14" FontAttributes="Bold" TextColor="#1A1A1A"/>
                                            <Label Text="{Binding RoomName, StringFormat='Room: {0}'}" FontSize="12" TextColor="#888888"/>
                                        </VerticalStackLayout>

                                        <!-- Dates -->
                                        <Label Grid.Row="1" Grid.Column="0" FontSize="11" TextColor="#888888">
                                            <Label.Text>
                                                <MultiBinding StringFormat="{}{0:MMM d} → {1:MMM d, yyyy} ({2} nights)">
                                                    <Binding Path="CheckIn"/>
                                                    <Binding Path="CheckOut"/>
                                                    <Binding Path="Nights"/>
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>

                                        <!-- Status Badge -->
                                        <Border Grid.Row="0" Grid.Column="1" Padding="8,4" StrokeShape="RoundRectangle 12" StrokeThickness="0"
                                                BackgroundColor="{Binding PaymentStatus, Converter={StaticResource ActivePageColorConverter}}">
                                            <Label Text="{Binding PaymentStatus}" FontSize="11" FontAttributes="Bold"/>
                                        </Border>

                                        <!-- Total computed price -->
                                        <VerticalStackLayout Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" VerticalOptions="Center" HorizontalOptions="End">
                                            <Label Text="{Binding ComputedTotalPrice, StringFormat='{0:C}'}" FontSize="16" FontAttributes="Bold" TextColor="#1A1A1A" HorizontalTextAlignment="End"/>
                                            <Label Text="{Binding TotalChargesPrice, StringFormat='Extras: {0:C}'}" FontSize="11" TextColor="#4C4EE7" HorizontalTextAlignment="End"/>
                                        </VerticalStackLayout>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

        </Grid>
    </Grid>
</ContentView>