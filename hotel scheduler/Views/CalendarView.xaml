<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:hotel_scheduler.ViewModels"
             x:Class="hotel_scheduler.Views.CalendarView"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto,*">

        <!-- Top bar -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto"
              Padding="16,12"
              BackgroundColor="White">

            <!-- Left: date navigation -->
            <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">

                <!-- Left arrow -->
                <Button Text="←"
                        BackgroundColor="White"
                        TextColor="#1A1A1A"
                        BorderColor="#E0E0E0"
                        BorderWidth="1"
                        CornerRadius="20"
                        WidthRequest="36"
                        HeightRequest="36"
                        Padding="0"
                        Command="{Binding ShiftBackwardCommand}"/>

                <!-- Date range label -->
                <Border Stroke="#E0E0E0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        Padding="14,8">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenDatePickerCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="{Binding DateRangleLabel}"
                           FontSize="14"
                           TextColor="#1A1A1A"
                           VerticalOptions="Center"/>
                </Border>

                <!-- Right arrow -->
                <Button Text="→"
                        BackgroundColor="White"
                        TextColor="#1A1A1A"
                        BorderColor="#E0E0E0"
                        BorderWidth="1"
                        CornerRadius="20"
                        WidthRequest="36"
                        HeightRequest="36"
                        Padding="0"
                        Command="{Binding ShiftForwardCommand}"/>

                <!-- Day count selector -->
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Button Text="-"
                            BackgroundColor="White"
                            TextColor="#1A1A1A"
                            BorderColor="#E0E0E0"
                            BorderWidth="1"
                            CornerRadius="20"
                            WidthRequest="36"
                            HeightRequest="36"
                            Padding="0"
                            Command="{Binding DecreaseDaysCommand}"/>
                    <Label Text="{Binding DayCount, StringFormat='{0} days'}"
                           FontSize="13"
                           TextColor="#1A1A1A"
                           VerticalOptions="Center"
                           MinimumWidthRequest="54"
                           HorizontalTextAlignment="Center"/>
                    <Button Text="+"
                            BackgroundColor="White"
                            TextColor="#1A1A1A"
                            BorderColor="#E0E0E0"
                            BorderWidth="1"
                            CornerRadius="20"
                            WidthRequest="36"
                            HeightRequest="36"
                            Padding="0"
                            Command="{Binding IncreaseDaysCommand}"/>
                </HorizontalStackLayout>
            </HorizontalStackLayout>

            <!-- Right: new reservation -->
            <Button Grid.Column="2"
                    Text="New reservation"
                    BackgroundColor="White"
                    TextColor="#1A1A1A"
                    BorderColor="#E0E0E0"
                    BorderWidth="1"
                    CornerRadius="20"
                    FontSize="14"
                    Padding="16,8"
                    Command="{Binding OpenNewReservationCommand}"/>
        </Grid>

        <!-- Calendar grid — built dynamically in code-behind -->
        <ScrollView Grid.Row="1" Orientation="Both">
            <Grid x:Name="CalendarGrid"
                  BackgroundColor="White"
                  Margin="16"
                  HorizontalOptions="Fill"
                  VerticalOptions="Start"/>
        </ScrollView>

    </Grid>
</ContentView>